rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{companyId} {
      allow read: if true;
      allow write: if true;
    }
    match /meta/{metaId} {
      allow read: if true;
      allow write: if true;
    }
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
